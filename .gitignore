# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# build and tool caches
/dist/
/.vite/
/.cache/
/.eslintcache
*.tsbuildinfo
vite.config.*.timestamp-*

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem

# local editors
/.vscode/
/.idea/
*.code-workspace

# debug
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/.wrangler/
/outputs/
/work/
/.npm-cache/
/dev.stdout.log
/dev.stderr.log

# local source exports and agent working notes
/high level/
/docs/superpowers/
